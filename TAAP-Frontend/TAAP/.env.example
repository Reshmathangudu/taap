# Browser-side service-layer flag used by Vite.
# true  = QE Engineer home uses mock.json
# false = QE Engineer home calls /api on the UI dev server, which proxies to the local service layer
VITE_TAAP_IS_MOCK=false
VITE_TAAP_SERVICE_URL=http://127.0.0.1:8787
VITE_TAAP_TEST_CASE_AGENT_URL=http://127.0.0.1:8001

# Optional. If omitted, the Node service uses JIRA_PROJECT_KEY below.
VITE_TAAP_JIRA_PROJECT_KEY=SCRUM

# Base URL of the Risk Tier agent's FastAPI backend, used by the Risk Tier
# card under Agent Reviews. Defaults to http://127.0.0.1:4000 if omitted.
VITE_API_BASE_URL=http://127.0.0.1:4000

# Node service-layer settings. These are used by npm run service:start and npm run fetch:jira.
TAAP_SERVICE_PORT=8787
TAAP_TEST_CASE_AGENT_URL=http://127.0.0.1:8001
TAAP_TEST_CASE_AGENT_TIMEOUT_MS=120000
JIRA_PROJECT_KEY=SCRUM
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=replace-with-your-token
JIRA_MCP_PAGE_SIZE=100
JIRA_MCP_MAX_PAGES=1000
# Optional comma-separated custom field IDs if criteria use a tenant-specific field name.
# Fields named Acceptance Criteria / Acceptance_Criteria / AC are discovered automatically.
JIRA_ACCEPTANCE_CRITERIA_FIELDS=

# Frontend-only LLM prototype: VITE_* values are visible to browser users.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-6-astra
